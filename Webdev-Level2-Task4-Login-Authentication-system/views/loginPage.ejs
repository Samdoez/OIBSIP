<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/index.css">
    <title>Login</title>
</head>
<body>
    <div class="intro-nav flex">
        <h1>Welcome to Login Page</h1>
    </div>
    <div class="main-cont flex">
        <h2 class="">Login your Account</h2>
        
        <div class="reg-cont-login-page flex">
            <form class="form-flex flex" id="registerForm" action="/loginUser" method="post" autocomplete="off" novalidate>
                <div>
                    <label for="email">Email</label> <br/>
                    <input type="email" name="email" id="email" placeholder="enter your email" autocomplete="off"
                    value="<%= typeof formData !== 'undefined' ? formData.email : '' %>" /> <br/>
                    
                    <small class="error-msg-style" id="emailError">
                        <%= locals.error ? error : "" %>
                    </small>
                </div>
            
                <div>
                    <label for="password">Password</label> <br/>
                    <input type="password" name="password" id="password" placeholder="create password" autocomplete="off" /> <br/>

                    <small class="error-msg-style" id="passwordError">
                        <%= locals.error ? error : "" %>
                    </small>
                </div>
                
                <button class="btn-link" type="submit">Login</button>
            </form>
            
            <a href="/" class="link-login"> No Account click to <strong>Register</strong></a> 
            <p class="err-style">
                <% if (locals.error) { %>
                    <%= error %>
            <% } %>
            </p>
    </div>
    </div>

    <script>
        const form = document.getElementById('registerForm');
        const emailInput = document.getElementById('email');
        const passwordInput = document.getElementById('password');

        const emailError = document.getElementById('emailError');
        const passwordError = document.getElementById('passwordError');

        const emailStructureRegex = /^[^\s@]+@[^\s@]+\.(com|net|org|edu|gov|io|co|ng)$/i;
        const emailTypoRegex = /@(gmai|gmal|gmial|yaho|outloo|hotmai)\.(com|net|org)$/i;


    form.addEventListener('submit', (e) => {
        let isValid = true;
        emailError.textContent = '';
        passwordError.textContent = '';

        const email = emailInput.value.trim();
        const password = passwordInput.value.trim();

        if (!email){
                emailError.textContent = 'email is required';
                isValid = false;
        }else if (!emailStructureRegex.test(email)){
                emailError.textContent= 'please enter a valid email address';
                isValid = false;
        }else if (emailTypoRegex.test(email)){
                emailError.textContent= 'Email address typo error';
                isValid = false;
        } 

        if (!password){
                passwordError.textContent = 'password is required';
                isValid = false;
        } else if(password.length < 8){
                passwordError.textContent = 'password must be at least 8 characters';
                isValid = false;
        } else if(!/[A-Z]/.test(password)){
                passwordError.textContent = 'password must contain an UpperCase';
                isValid = false;
        } else if(!/[0-9]/.test(password)){
                passwordError.textContent = 'password must contain an number';
                isValid = false;
        } else if(!/[^A-Za-z0-9]/.test(password)){
                passwordError.textContent = 'password must contain a special character';
                isValid = false;
        }
        
        if (!isValid) {
            e.preventDefault(); // Stop submission until fixed
        }
        });
    </script>
</body>
</html>